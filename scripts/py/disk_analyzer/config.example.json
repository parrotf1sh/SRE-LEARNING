{
  "alert": {
    "warning_threshold": 80.0,
    "critical_threshold": 90.0
  },
  "filter": {
    "exclude_fstypes": ["tmpfs", "proc", "devtmpfs", "sysfs"],
    "exclude_dirs": [],
    "min_size": 0
  },
  "output": {
    "format": "table",
    "color": true
  },
  "scheduler": {
    "interval": 3600
  }
}
